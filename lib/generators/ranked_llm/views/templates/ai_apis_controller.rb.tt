module Settings
  class AiApisController < ApplicationController
    before_action :require_account! # TODO: replace with this app's real auth boundary
    before_action :set_credential, only: [ :destroy, :move ]

    def index
      @task_type = params[:task_type].presence || Llm::TaskType::DEFAULT
      @task_type = Llm::TaskType::DEFAULT unless Llm::TaskType.valid?(@task_type)
      @credentials = current_account.llm_credentials.for_task_type(@task_type).ranked
      # Which task types are actually ranked, so the picker can show at a
      # glance where an override exists rather than a flat list.
      @configured_task_types = current_account.llm_credentials.distinct.pluck(:task_type)
      usage_this_month = current_account.llm_usage_records.this_month.group(:provider, :model)
      @monthly_cost_by_provider_model = usage_this_month.sum(:cost_usd)
      @monthly_tokens_by_provider_model = usage_this_month.sum("input_tokens + output_tokens")
    end

    def create
      provider, model = params[:llm_credential][:provider_and_model].to_s.split(":", 2)
      task_type = params[:llm_credential][:task_type].presence || Llm::TaskType::DEFAULT
      credential = current_account.llm_credentials.new(provider: provider, model: model, task_type: task_type,
                                                       api_key: params[:llm_credential][:api_key])
      if credential.save
        redirect_to index_path_for(credential.task_type), notice: "AI API added."
      else
        redirect_to index_path_for(task_type), alert: credential.errors.full_messages.to_sentence
      end
    end

    def destroy
      task_type = @credential.task_type
      @credential.destroy
      redirect_to index_path_for(task_type), notice: "AI API removed."
    end

    def move
      @credential.update!(position: params[:position].to_i.clamp(1, 100))
      head :ok
    end

    private

    # The default list keeps the bare URL, so nothing changes for an account
    # that never ranks a job separately.
    def index_path_for(task_type)
      return settings_ai_apis_path if task_type == Llm::TaskType::DEFAULT

      settings_ai_apis_path(task_type: task_type)
    end

    def set_credential
      @credential = current_account.llm_credentials.find(params[:id])
    end
  end
end
